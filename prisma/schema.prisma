generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  code                  String                 @unique
  logo                  String?
  accentColor           String                 @default("#111111")
  phone                 String?
  status                String                 @default("trial")
  adminCommission       Float                  @default(20)
  gatewayCharge         Float                  @default(2.36)
  razorpayKeyId         String?
  razorpayKeySecret     String?
  razorpayAccountId     String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  banners               Banner[]
  blogs                 Blog[]
  bookmarks             Bookmark[]
  categories            Category[]
  certificates          Certificate[]
  chapters              Chapter[]
  chatConversations     ChatConversation[]
  collections           Collection[]
  combos                Combo[]
  concepts              Concept[]
  coupons               Coupon[]
  courses               Course[]
  courseNotes           CourseNote[]
  departments           Department[]
  digitalProducts       DigitalProduct[]
  documents             Document[]
  examProfiles          ExamProfile[]
  examRules             ExamRule[]
  examThemes            ExamTheme[]
  leads                 Lead[]
  meetings              Meeting[]
  notifications         Notification[]
  offerings             Offering[]
  omrTemplates          OmrTemplate[]
  orders                Order[]
  payments              Payment[]
  paymentPages          PaymentPage[]
  payouts               Payout[]
  quickLinks            QuickLink[]
  sections              Section[]
  storeProducts         StoreProduct[]
  students              Student[]
  supportQueries        SupportQuery[]
  tags                  Tag[]
  tests                 Test[]
  testSeries            TestSeries[]
  users                 User[]
  whatsappCampaigns     WhatsAppCampaign[]
  whatsappConfigs       WhatsAppConfig[]
  whatsappConversations WhatsAppConversation[]
  youtubeCourses        YoutubeCourse[]
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String
  password             String
  role                 String         @default("teacher")
  phone                String?
  avatar               String?
  organizationId       String?
  failedLoginAttempts  Int            @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?      @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  twoFactorEnabled     Boolean        @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String?
  resetToken           String?
  resetTokenExpiry     DateTime?
  bannerImage          String?
  portalLogo           String?
  activeSessionId      String?
  loginAttempts        LoginAttempt[]
  students             Student[]      @relation("TeacherToStudent")
  organization         Organization?  @relation(fields: [organizationId], references: [id])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [email], references: [email])
}

model Student {
  id                       String                    @id @default(cuid())
  name                     String
  email                    String
  phone                    String?
  avatar                   String?
  isActive                 Boolean                   @default(true)
  organizationId           String
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  userId                   String?
  blockedAt                DateTime?
  blockedReason            String?
  isBlocked                Boolean                   @default(false)
  departmentId             String?
  address                  String?
  city                     String?
  pincode                  String?
  state                    String?
  teacherId                String?
  activeSessionId          String?
  assignmentSubmissions    AssignmentSubmission[]
  bookmarks                Bookmark[]
  certificates             Certificate[]
  collections              Collection[]
  courseNotes              CourseNote[]
  deviceSessions           DeviceSession[]
  lessonProgress           LessonProgress[]
  orders                   Order[]
  purchasedCourses         PurchasedCourse[]
  purchasedDigitalProducts PurchasedDigitalProduct[]
  purchasedTestSeries      PurchasedTestSeries[]
  streak                   Streak?
  department               Department?               @relation(fields: [departmentId], references: [id])
  organization             Organization              @relation(fields: [organizationId], references: [id])
  teacher                  User?                     @relation("TeacherToStudent", fields: [teacherId], references: [id])
  studentAchievements      StudentAchievement[]
  testAttempts             TestAttempt[]
}

model DeviceSession {
  id         String    @id @default(cuid())
  studentId  String
  deviceId   String?
  deviceName String?
  deviceType String    @default("mobile")
  browser    String?
  os         String?
  ipAddress  String?
  location   String?
  lastActive DateTime  @default(now())
  isActive   Boolean   @default(true)
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Category {
  id             String       @id @default(cuid())
  name           String
  slug           String
  icon           String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  chapters       Chapter[]
}

model Chapter {
  id             String       @id @default(cuid())
  name           String
  description    String?
  categoryId     String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  category       Category?    @relation(fields: [categoryId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  concepts       Concept[]
  tests          Test[]
}

model Concept {
  id             String       @id @default(cuid())
  name           String
  description    String?
  chapterId      String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  chapter        Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  tests          Test[]
}

model Course {
  id              String            @id @default(cuid())
  title           String
  description     String?
  thumbnail       String?
  price           Float             @default(0)
  mrp             Float             @default(0)
  category        String?
  status          String            @default("draft")
  organizationId  String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  content         String?
  demoVideo       String?
  discountCode    String?
  featured        Boolean           @default(false)
  language        String            @default("Hindi")
  level           String            @default("All")
  sortOrder       Int               @default(0)
  validityEndDate DateTime?
  validityMonths  Int?
  validityType    String            @default("lifetime")
  parentId        String?
  richSnippets    Boolean           @default(false)
  seoDescription  String?
  seoTitle        String?
  assignments     Assignment[]
  certificates    Certificate[]
  organization    Organization      @relation(fields: [organizationId], references: [id])
  parent          Course?           @relation("CourseHierarchy", fields: [parentId], references: [id])
  children        Course[]          @relation("CourseHierarchy")
  chats           CourseChat[]
  modules         CourseModule[]
  forum           Forum?
  liveClasses     LiveClass[]
  purchasedBy     PurchasedCourse[]
}

model CourseModule {
  id          String         @id @default(cuid())
  title       String
  description String?
  sortOrder   Int            @default(0)
  courseId    String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assignments Assignment[]
  lessons     CourseLesson[]
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseLesson {
  id                 String             @id @default(cuid())
  title              String
  type               String             @default("video")
  content            String?
  videoUrl           String?
  videoDuration      Int                @default(0)
  fileUrl            String?
  notes              String?
  isFree             Boolean            @default(false)
  sortOrder          Int                @default(0)
  moduleId           String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  translationStatus  String             @default("none")
  allowPdfDownload   Boolean            @default(false)
  securePdfWithPhone Boolean            @default(false)
  isOptional         Boolean            @default(false)
  checkpointQuiz     CheckpointQuiz?
  module             CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  courseNotes        CourseNote[]
  progress           LessonProgress[]
  translations       VideoTranslation[]
}

model VideoTranslation {
  id             String       @id @default(cuid())
  lessonId       String
  languageCode   String
  languageName   String
  subtitleVttUrl String?
  audioTrackUrl  String?
  createdAt      DateTime     @default(now())
  lesson         CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  id           String       @id @default(cuid())
  studentId    String
  lessonId     String
  courseId     String
  status       String       @default("not_started")
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  lastPosition String?
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id])

  @@unique([studentId, lessonId])
}

model CourseNote {
  id             String       @id @default(cuid())
  studentId      String
  lessonId       String
  content        String
  timestamp      Int?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lesson         CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  student        Student      @relation(fields: [studentId], references: [id])
}

model TestSeries {
  id               String                @id @default(cuid())
  title            String
  description      String?
  thumbnail        String?
  price            Float                 @default(0)
  mrp              Float                 @default(0)
  category         String?
  isCombo          Boolean               @default(false)
  includeTestMaker Boolean               @default(false)
  allowPayment     Boolean               @default(true)
  validityMode     String                @default("lifetime")
  validityDays     Int?
  endDate          DateTime?
  seoTitle         String?
  seoDescription   String?
  richSnippets     Boolean               @default(false)
  sortOrder        Int                   @default(0)
  status           String                @default("draft")
  organizationId   String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  discount         Float                 @default(0)
  parentId         String?
  purchasedBy      PurchasedTestSeries[]
  tests            Test[]
  organization     Organization          @relation(fields: [organizationId], references: [id])
  parent           TestSeries?           @relation("SubSeries", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children         TestSeries[]          @relation("SubSeries")
}

model Offering {
  id                 String       @id @default(cuid())
  title              String
  description        String?
  thumbnail          String?
  price              Float        @default(0)
  mrp                Float        @default(0)
  validityMode       String       @default("lifetime")
  validityDays       Int?
  endDate            DateTime?
  includedCourses    String       @default("[]")
  includedTestSeries String       @default("[]")
  featuredBullets    String       @default("[]")
  status             String       @default("draft")
  sortOrder          Int          @default(0)
  seoTitle           String?
  seoDescription     String?
  organizationId     String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id])
}

model Test {
  id                   String        @id @default(cuid())
  title                String
  instructions         String?
  status               String        @default("free")
  isLive               Boolean       @default(false)
  isLocked             Boolean       @default(false)
  numberOfQuestions    Int           @default(0)
  totalMarks           Float         @default(0)
  totalDuration        Int           @default(0)
  sortOrder            Int           @default(0)
  sectionWiseMarks     Boolean       @default(false)
  negativeMarks        Float         @default(0)
  startDate            DateTime?
  endDate              DateTime?
  language             String        @default("english")
  translationTitle     String?
  maxAttempts          Int           @default(1)
  shuffleQuestions     Boolean       @default(false)
  shuffleOptions       Boolean       @default(false)
  displayPause         Boolean       @default(false)
  allCompulsory        Boolean       @default(true)
  uiType               String        @default("default")
  attachPdf            String?
  allowPdfExport       Boolean       @default(false)
  partialScoring       Boolean       @default(false)
  displayResults       Boolean       @default(true)
  displayRank          Boolean       @default(true)
  showSolution         Boolean       @default(true)
  showTotalStudents    Boolean       @default(false)
  showPercentile       Boolean       @default(false)
  solutionLink         String?
  telegramSettings     String?
  testSeriesId         String
  organizationId       String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  isPdfTest            Boolean       @default(false)
  isSubjective         Boolean       @default(false)
  pdfUrl               String?
  examProfileId        String?
  allowAttempt         Boolean       @default(true)
  resultAt             DateTime?
  chapterId            String?
  conceptId            String?
  testMode             String        @default("CBT")
  allowPdfDownload     Boolean       @default(false)
  pdfPasswordProtected Boolean       @default(false)
  themeId              String?
  themeSnapshot        String?
  richSnippets         Boolean       @default(true)
  seoDescription       String?
  seoTitle             String?
  passages             Passage[]
  questions            Question[]
  chapter              Chapter?      @relation(fields: [chapterId], references: [id])
  concept              Concept?      @relation(fields: [conceptId], references: [id])
  examProfile          ExamProfile?  @relation(fields: [examProfileId], references: [id])
  organization         Organization  @relation(fields: [organizationId], references: [id])
  testSeries           TestSeries    @relation(fields: [testSeriesId], references: [id])
  theme                ExamTheme?    @relation(fields: [themeId], references: [id])
  testAttempts         TestAttempt[]
  testSections         TestSection[]
}

model TestSection {
  id              String   @id @default(cuid())
  testId          String
  sectionName     String
  maxQuestions    Int      @default(-1)
  partTitle       String?
  cutoffScore     Float    @default(0)
  isOptional      Boolean  @default(false)
  fixedTiming     Boolean  @default(false)
  durationMinutes Int      @default(0)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  test            Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
}

model Passage {
  id        String     @id @default(cuid())
  text      String
  image     String?
  testId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  test      Test       @relation(fields: [testId], references: [id])
  questions Question[]
}

model Question {
  id                String             @id @default(cuid())
  type              String             @default("mcq")
  heading           String?
  directive         String?
  title             String
  image1            String?
  image2            String?
  image3            String?
  option1           String?
  option2           String?
  option3           String?
  option4           String?
  option5           String?
  option1Image      String?
  option2Image      String?
  option3Image      String?
  option4Image      String?
  option5Image      String?
  correctOption     String?
  solutionHeading   String?
  solutionImage1    String?
  solutionImage2    String?
  solutionVideo     String?
  solutionText      String?
  section           String?
  positiveMarks     Float              @default(1)
  negativeMarks     Float              @default(0)
  sortOrder         Int                @default(0)
  testId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  examProfileId     String?
  option1Hi         String?
  option2Hi         String?
  option3Hi         String?
  option4Hi         String?
  option5Hi         String?
  partialMarks      Float              @default(0)
  passageId         String?
  solutionTextHi    String?
  titleHi           String?
  examProfile       ExamProfile?       @relation(fields: [examProfileId], references: [id])
  passage           Passage?           @relation(fields: [passageId], references: [id])
  test              Test               @relation(fields: [testId], references: [id])
  reportedQuestions ReportedQuestion[]
}

model TestAttempt {
  id              String    @id @default(cuid())
  studentId       String
  testId          String
  score           Float     @default(0)
  totalMarks      Float     @default(0)
  rank            Int?
  percentile      Float?
  timeTaken       Int       @default(0)
  status          String    @default("in_progress")
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  answers         String?
  omrImageUrl     String?
  isPractice      Boolean   @default(false)
  themeSnapshot   String?
  timePerQuestion String?
  student         Student   @relation(fields: [studentId], references: [id])
  test            Test      @relation(fields: [testId], references: [id])
}

model ReportedQuestion {
  id         String   @id @default(cuid())
  questionId String
  studentId  String?
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  question   Question @relation(fields: [questionId], references: [id])
}

model Blog {
  id             String       @id @default(cuid())
  title          String
  content        String?
  thumbnail      String?
  status         String       @default("draft")
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  excerpt        String?
  tags           String?
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model QuickLink {
  id             String       @id @default(cuid())
  title          String
  url            String
  icon           String?
  sortOrder      Int          @default(0)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Banner {
  id             String       @id @default(cuid())
  title          String
  image          String
  link           String?
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  description    String?
  endDate        DateTime?
  mobileImage    String?
  position       String       @default("homepage")
  startDate      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Coupon {
  id                   String       @id @default(cuid())
  code                 String
  discount             Float
  discountType         String       @default("percentage")
  maxUses              Int?
  usedCount            Int          @default(0)
  validFrom            DateTime?
  validTo              DateTime?
  isActive             Boolean      @default(true)
  organizationId       String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  applicableProductIds String[]
  minPurchaseAmount    Float?
  organization         Organization @relation(fields: [organizationId], references: [id])
}

model Notification {
  id             String       @id @default(cuid())
  title          String
  message        String
  type           String       @default("info")
  organizationId String
  createdAt      DateTime     @default(now())
  isRead         Boolean      @default(false)
  targetRole     String       @default("all")
  recipientId    String?
  senderId       String?
  senderName     String?
  senderRole     String?
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Lead {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  source         String?
  status         String       @default("new")
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  notes          String?
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ProductView {
  id             String   @id @default(cuid())
  studentId      String?
  sessionId      String?
  productId      String
  productType    String
  views          Int      @default(1)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sessionId, productId])
  @@index([organizationId, productType])
}

model SupportQuery {
  id             String       @id @default(cuid())
  subject        String
  message        String
  status         String       @default("open")
  studentName    String?
  studentEmail   String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Order {
  id                String       @id @default(cuid())
  studentId         String
  items             String
  totalAmount       Float
  status            String       @default("pending")
  couponCode        String?
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  razorpayOrderId   String?
  razorpayPaymentId String?
  discountAmount    Float        @default(0)
  finalAmount       Float        @default(0)
  organization      Organization @relation(fields: [organizationId], references: [id])
  student           Student      @relation(fields: [studentId], references: [id])
  payments          Payment[]
}

model Payment {
  id              String       @id @default(cuid())
  orderId         String
  amount          Float
  method          String?
  status          String       @default("pending")
  transactionId   String?
  organizationId  String
  createdAt       DateTime     @default(now())
  gatewayCharge   Float        @default(0)
  adminCommission Float        @default(0)
  teacherAmount   Float        @default(0)
  order           Order        @relation(fields: [orderId], references: [id])
  organization    Organization @relation(fields: [organizationId], references: [id])
}

model PurchasedCourse {
  id             String    @id @default(cuid())
  studentId      String
  courseId       String
  organizationId String
  purchasedAt    DateTime  @default(now())
  expiresAt      DateTime?
  course         Course    @relation(fields: [courseId], references: [id])
  student        Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, courseId])
}

model PurchasedTestSeries {
  id             String     @id @default(cuid())
  studentId      String
  testSeriesId   String
  organizationId String
  purchasedAt    DateTime   @default(now())
  expiresAt      DateTime?
  student        Student    @relation(fields: [studentId], references: [id])
  testSeries     TestSeries @relation(fields: [testSeriesId], references: [id])

  @@unique([studentId, testSeriesId])
}

model DigitalProduct {
  id             String                    @id @default(cuid())
  title          String
  description    String?
  thumbnail      String?
  file           String?
  price          Float                     @default(0)
  status         String                    @default("draft")
  organizationId String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  category       String?
  featured       Boolean                   @default(false)
  mrp            Float                     @default(0)
  type           String                    @default("course")
  author         String?
  chapter        String?
  duration       String?
  edition        String?
  format         String?
  isbn           String?
  language       String?
  level          String?
  pages          Int?
  productType    String?
  publisher      String?
  subject        String?
  syllabus       String?
  totalQuestions Int?
  totalTests     Int?
  validityDays   Int?
  richSnippets   Boolean                   @default(false)
  seoDescription String?
  seoTitle       String?
  organization   Organization              @relation(fields: [organizationId], references: [id])
  purchasedBy    PurchasedDigitalProduct[]
}

model PurchasedDigitalProduct {
  id               String         @id @default(cuid())
  studentId        String
  digitalProductId String
  orderItemId      String?
  accessUrl        String?
  expiresAt        DateTime?
  createdAt        DateTime       @default(now())
  digitalProduct   DigitalProduct @relation(fields: [digitalProductId], references: [id], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, digitalProductId])
}

model TeacherModuleAccess {
  id        String   @id @default(cuid())
  teacherId String
  moduleKey String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique([teacherId, moduleKey])
}

model ModuleAccessLog {
  id          String   @id @default(cuid())
  teacherId   String
  teacherName String?
  moduleKey   String
  action      String
  changedBy   String?
  changedAt   DateTime @default(now())
  details     String?
}

model EmailLog {
  id             String    @id @default(cuid())
  to             String
  subject        String
  body           String
  status         String    @default("pending")
  type           String    @default("notification")
  organizationId String?
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("false")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  userName       String?
  userRole       String?
  action         String
  category       String   @default("general")
  details        String?
